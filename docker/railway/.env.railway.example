# ---- comum a api, worker e ws ----
NODE_ENV=production
MONGO_URL=mongodb://novu:<MONGO_INITDB_ROOT_PASSWORD>@mongodb.railway.internal:27017/novu-db?authSource=admin
MONGO_MIN_POOL_SIZE=10
MONGO_MAX_POOL_SIZE=200
REDIS_HOST=redis.railway.internal
REDIS_PORT=6379
NEW_RELIC_ENABLED=false

# ---- api (porta 3000) ----
PORT=3000
API_ROOT_URL=https://<dominio-da-api>
FRONT_BASE_URL=https://<dominio-do-dashboard>
MONGO_AUTO_CREATE_INDEXES=true
REDIS_DB_INDEX=2
REDIS_CACHE_SERVICE_HOST=redis.railway.internal
REDIS_CACHE_SERVICE_PORT=6379
JWT_SECRET=<openssl rand -hex 32>
STORE_ENCRYPTION_KEY=<openssl rand -hex 16>
NOVU_SECRET_KEY=<openssl rand -hex 32>
SUBSCRIBER_WIDGET_JWT_EXPIRATION_TIME=15 days
IS_SELF_HOSTED=true
IS_V2_ENABLED=true
IS_NEW_MESSAGES_API_RESPONSE_ENABLED=true
IS_API_IDEMPOTENCY_ENABLED=false
IS_API_RATE_LIMITING_ENABLED=false

# ---- worker (porta 3004) ----
PORT=3004
API_ROOT_URL=https://<dominio-da-api>
REDIS_DB_INDEX=2
REDIS_CACHE_SERVICE_HOST=redis.railway.internal
REDIS_CACHE_SERVICE_PORT=6379
STORE_ENCRYPTION_KEY=<mesmo da api>
SUBSCRIBER_WIDGET_JWT_EXPIRATION_TIME=15 days
BROADCAST_QUEUE_CHUNK_SIZE=100
MULTICAST_QUEUE_CHUNK_SIZE=100
IS_EMAIL_INLINE_CSS_DISABLED=false
IS_USE_MERGED_DIGEST_ID_ENABLED=false

# ---- ws (porta 3002) ----
PORT=3002
JWT_SECRET=<mesmo da api>

# ---- dashboard (porta 4000) ----
PORT=4000
VITE_API_HOSTNAME=https://<dominio-da-api>
VITE_WEBSOCKET_HOSTNAME=https://<dominio-do-ws>
VITE_SELF_HOSTED=true

# ---- mongodb ----
MONGO_INITDB_ROOT_USERNAME=novu
MONGO_INITDB_ROOT_PASSWORD=<openssl rand -hex 16>
